# Copie para .env e preencha. Gerar valores: openssl rand -hex 24

# Segredo do Raspberry Pi (o mesmo valor vai para EINK_TOKEN no Pi)
DEVICE_TOKEN=

# Primeiro administrador local (só no primeiro arranque; depois gere-se na página /admin)
UI_USER=admin
UI_PASSWORD=

# Office 365 (opcional). Preencher os 4 para ativar o botão "Entrar com Office 365"
PUBLIC_URL=https://avaliar.techpro.pt
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
