# Copia para .env e preenche. Nunca o publiques.

# Domínio público (sem https://) e endereço completo, exatamente como se abre no navegador.
# Só na instalação com Caddy (VPS). No Unraid pode ficar de fora.
DOMINIO=sala.techpro.pt
BASE_URL=https://sala.techpro.pt

# Aplicação registada no Microsoft Entra ID (ver LEIA-ME.md, passo 1).
TENANT_ID=00000000-0000-0000-0000-000000000000
CLIENT_ID=00000000-0000-0000-0000-000000000000
CLIENT_SECRET=

# Grupo «docentes» do Microsoft Entra ID (ID do objeto do grupo), como no helpdesk-escolar. Quem pertence ao grupo entra sozinho
# e aparece em «Docentes»; quem sai do grupo deixa de poder entrar. Sem esta variável, o administrador adiciona os docentes à mão.
# A aplicação usa a permissão delegada User.Read (a que já tem) para perguntar ao Microsoft Graph «/me/memberOf/<grupo>».
GRUPO_DOCENTES_ID=
# Opcional: grupo do Entra ID cujos membros são administradores (além dos de ADMIN_USERS).
GRUPO_ADMIN_ID=

# Administradores (entram sempre e dão acesso aos outros docentes). Emails completos, separados por vírgulas.
ADMIN_USERS=pedro.sendas@queiroz.pt

# Domínios aceites. O domínio da escola inclui alunos, por isso só entra quem um administrador adicionou em «Docentes».
DOMINIOS_PERMITIDOS=queiroz.pt

SESSAO_HORAS=8
OIDC_PROMPT=select_account
TZ=Europe/Lisbon

# 1 quando a aplicação está atrás do Caddy (docker-compose): o limite de pedidos das páginas dos alunos usa o IP real.
TRUST_PROXY=1
# 0 desliga as cópias de segurança automáticas (não aconselhado).
# COPIAS=0
